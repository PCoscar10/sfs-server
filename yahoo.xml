          <isPrivate>false</isPrivate>
          <isPersistent>false</isPersistent>
          <isGlobal>false</isGlobal>
          <isHidden>false</isHidden>
          <isStorable>true</isStorable>
        </variable>
        <variable>
          <name>bots</name>
          <value>[{"key":"giftStandNew","height":6,"width":2,"length":1,"posX":35,"posY":24,"ver":0,"atlas":0,"property":{"cn":"ShopPanelProperty","shopID":21,"revenueShare":"0"},"speechProperty":{"cn":"SpeechProperty","list":[{"event":"casual","message":" YAHOO CITY","$$hashKey":"object:22526"},{"event":"welcome","message":"Welcome to Yahoo City!","$$hashKey":"object:4957"}]}}]</value>
          <type>STRING</type>
          <isPrivate>false</isPrivate>
          <isPersistent>false</isPersistent>
          <isGlobal>false</isGlobal>
          <isHidden>false</isHidden>
          <isStorable>true</isStorable>
        </variable>
        <variable>
          <name>roomKey</name>
          <value>street01</value>
          <type>STRING</type>
          <isPrivate>false</isPrivate>
          <isPersistent>false</isPersistent>
          <isGlobal>false</isGlobal>
          <isHidden>false</isHidden>
          <isStorable>true</isStorable>
        </variable>
        <variable>
          <name>width</name>
          <value>800</value>
          <type>INT</type>
          <isPrivate>false</isPrivate>
          <isPersistent>false</isPersistent>
          <isGlobal>false</isGlobal>
          <isHidden>false</isHidden>
          <isStorable>true</isStorable>
        </variable>
        <variable>
          <name>height</name>
          <value>515</value>
